# ==============================================================================
# SOUTH SIDE INTERNATIONAL RESOURCES (SSIR) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Destination email where submitted advisory inquiries will be delivered
CLIENT_RECEIVING_EMAIL=info@southsideresources.com

# ------------------------------------------------------------------------------
# SERVICE OPTION 1: Web3Forms (FASTEST - No password, no account required)
# 1. Go to https://web3forms.com
# 2. Enter YOUR own developer email to receive a free Access Key in 5 seconds
# 3. Paste the key below.
# 4. In your personal email, set an auto-forward filter:
#    "If sender is web3forms -> forward to info@southsideresources.com"
# ------------------------------------------------------------------------------
WEB3FORMS_ACCESS_KEY=

# ------------------------------------------------------------------------------
# SERVICE OPTION 2: Brevo / Sendinblue (DIRECT - 300 free emails/day)
# 1. Sign up for free at https://app.brevo.com with your developer email
# 2. Go to SMTP & API -> Create API key
# 3. Paste your key and verified sender below. Inquiries land directly in the
#    client's inbox with ZERO verification code required from the client!
# ------------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=inquiries@yourdomain.com

# ------------------------------------------------------------------------------
# SERVICE OPTION 3: Resend (Vercel native)
# 1. Sign up at https://resend.com
# 2. Get API key from API Keys dashboard
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_SENDER_EMAIL=onboarding@resend.dev
